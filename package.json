{
  "name": "base-reminder",
  "version": "0.1.0",
  "description": "Internal Base.vn to Telegram morning reminder system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/src/index.js",
    "migrate": "node dist/src/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "sync:users": "node dist/src/sync/sync-cli.js",
    "sync:users:dev": "tsx src/sync/sync-cli.ts",
    "digest:preview": "node dist/src/cli/digest-preview.js",
    "digest:preview:dev": "tsx src/cli/digest-preview.ts",
    "reminder:dry-run": "node dist/src/cli/reminder-dry-run.js",
    "reminder:dry-run:dev": "tsx src/cli/reminder-dry-run.ts",
    "reminder:send-test": "node dist/src/cli/send-test-reminder.js",
    "reminder:send-test:dev": "tsx src/cli/send-test-reminder.ts",
    "reminder:send-preview": "node dist/src/cli/send-preview.js",
    "reminder:send-preview:dev": "tsx src/cli/send-preview.ts",
    "pipeline:run": "node dist/src/cli/pipeline-run.js",
    "pipeline:run:dev": "tsx src/cli/pipeline-run.ts",
    "probe": "tsx scripts/probe-base-api.ts",
    "probe:request": "tsx scripts/probe-request-deep.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "grammy": "^1.45.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "p-limit": "^6.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}