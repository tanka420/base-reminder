# ============================================================
# Base Reminder — Environment Variables
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# See docs/architecture-review.md Appendix A for full reference.
# ============================================================

# === Database (Required) ===
# Full PostgreSQL connection string. Credentials must never be logged.
DATABASE_URL=postgresql://base_reminder:changeme@localhost:5432/base_reminder

# === Base API Tokens — access_token_v2 (All Required) ===
# One token per Base module. Tokens are NOT interchangeable.
# Create at: https://account.base.vn → Tích hợp với bên thứ ba ver 2

# Token for Base Account app
BASE_ACCOUNT_TOKEN=

# Token for Base Wework app
BASE_WEWORK_TOKEN=

# Token for Base Workflow app
BASE_WORKFLOW_TOKEN=

# Token for Base Request app
BASE_REQUEST_TOKEN=

# Token for Base Sign app (M2C)
BASE_SIGN_TOKEN=

# === Scheduler (Optional — default: Asia/Ho_Chi_Minh) ===
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
REMINDER_CRON="15 8 * * 1-5"
ENABLE_CRON_SCHEDULER=false
# Missed run cutoff hour (0-23, Asia/Ho_Chi_Minh). Missed runs after this hour will not automatically send.
MISSED_RUN_CUTOFF_HOUR=10

# === Health Endpoint (Optional — defaults shown) ===
# Bind to 127.0.0.1 by default (localhost only — not publicly exposed)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000

# === Application (Optional — defaults shown) ===
LOG_LEVEL=info
NODE_ENV=production

# === Base API Client Tuning (Optional — defaults shown) ===
BASE_API_TIMEOUT_MS=15000
BASE_API_CONCURRENCY=3

# ============================================================
# M2A Variables (Telegram Bot & Email OTP)
# ============================================================
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=

# === SMTP Configuration (for OTP emails) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM="Base Reminder <noreply@example.com>"

# === OTP Policy Tuning (Optional — defaults shown) ===
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX_REQUESTS=5

# ============================================================
# M0 / Probe Script Variables (for npm run probe only)
# ============================================================
# Not used by the production app — only by M0 probe scripts.

# Usernames to probe (comma-separated)
BASE_PROBE_USERNAMES=

# Optional fixture IDs for deep probe
PROBE_WEWORK_TASK_ID=
PROBE_WORKFLOW_JOB_ID=
PROBE_REQUEST_ID=
