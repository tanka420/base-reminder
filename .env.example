# ==============================================================================
# Base Reminder — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in required values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# ==============================================================================
# Runtime
# ==============================================================================
NODE_ENV=production

# ==============================================================================
# PostgreSQL
# ==============================================================================
# Full connection string for application and migration runner.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://base_reminder:changeme@localhost:5432/base_reminder

# Database password used by docker-compose for the db container
DB_PASSWORD=changeme

# ==============================================================================
# Base Account
# ==============================================================================
# Required. Token from https://account.base.vn (access_token_v2)
BASE_ACCOUNT_TOKEN=

# ==============================================================================
# Base Wework
# ==============================================================================
# Required. Token from https://wework.base.vn (access_token_v2)
BASE_WEWORK_TOKEN=

# ==============================================================================
# Base Workflow
# ==============================================================================
# Required. Token from https://workflow.base.vn (access_token_v2)
BASE_WORKFLOW_TOKEN=

# ==============================================================================
# Base Request
# ==============================================================================
# Required. Token from https://request.base.vn (access_token_v2)
BASE_REQUEST_TOKEN=

# ==============================================================================
# Base Sign — PAUSED / NOT ACTIVE
# ==============================================================================
# Currently unused in production. Research checkpoint completed (M2C paused
# pending a supported server-to-server API endpoint).
BASE_SIGN_TOKEN=

# ==============================================================================
# Telegram
# ==============================================================================
# Bot activation flag. Set to true to start the Telegram bot polling process.
ENABLE_TELEGRAM_BOT=false

# Bot token from @BotFather (Required if ENABLE_TELEGRAM_BOT=true)
TELEGRAM_BOT_TOKEN=

# ==============================================================================
# SMTP (for OTP Verification Emails)
# ==============================================================================
# Required if ENABLE_TELEGRAM_BOT=true for user self-onboarding
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM="Base Reminder <noreply@example.com>"

# OTP Policy Configuration (defaults shown)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX_REQUESTS=5

# ==============================================================================
# Scheduler
# ==============================================================================
# Cron scheduler activation flag. Keep false initially during pilot deployment.
ENABLE_CRON_SCHEDULER=false

# Schedule expression (default: Mon-Fri at 08:00)
REMINDER_CRON="0 8 * * 1-5"
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh

# Cutoff hour (0-23) after which missed morning runs will not automatically trigger
MISSED_RUN_CUTOFF_HOUR=10

# Base API Client Concurrency & Timeout
BASE_API_TIMEOUT_MS=15000
BASE_API_CONCURRENCY=3

# ==============================================================================
# Logging / Health
# ==============================================================================
LOG_LEVEL=info

# Health endpoint bind host and port (localhost only — not exposed to Internet)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000

# ==============================================================================
# Probe / Development Utilities (Optional)
# ==============================================================================
BASE_PROBE_USERNAMES=
PROBE_WEWORK_TASK_ID=
PROBE_WORKFLOW_JOB_ID=
PROBE_REQUEST_ID=

